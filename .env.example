# 仅供服务端使用；绝不添加 NEXT_PUBLIC_ 前缀，也不要将真实 Key 提交到仓库。
# 留空仍能浏览、判题、查看揭晓与来源、改写和导出。
# AI 接口先检查审核门控：当前全部 pending，formal 返回 409；preview 无 Key 返回 503。
# 填入自己的 DeepSeek Key 后，配合 CONTENT_MODE=preview 开启本地 AI 预览。
AI_API_KEY=
# 服务端追加 /chat/completions。
AI_BASE_URL=https://api.deepseek.com
# 沿用代码默认模型 ID；可改为自己账号可用的模型 ID。
AI_MODEL=deepseek-flash
# 服务端请求超时（毫秒）；无效值回退 20000。
AI_TIMEOUT_MS=20000
# formal 只允许 reviewed；preview 允许 pending，响应与界面标注待审核。
CONTENT_MODE=formal

# 以下仅供手动运行验收脚本，npm run dev / build / start 无需配置。
# 直接运行 Node 脚本时须自行注入环境，或使用 node --env-file=.env.local scripts/脚本名.mjs。
# 浏览器路径：留空时优先 /usr/bin/google-chrome，否则使用 Playwright 安装的 Chromium。
CHROME_PATH=
# scripts/e2e.mjs 自动启动生产服务的端口，默认 3123。
E2E_PORT=3123
# 留空时自动启动服务；填写完整地址时使用已启动的服务。
E2E_BASE_URL=
# scripts/qa-ai.mjs 有 Key / 无 Key 服务端口，默认分别为 3134 / 3135；会真实调用模型。
AI_QA_PORT=3134
AI_QA_NO_KEY_PORT=3135
# scripts/qa-stage-3-ai.mjs 服务端口，默认 3136；会真实调用模型。
AI_QA_STAGE3_PORT=3136
